<Window x:Class="RussianDatingApp.View.EditUserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование профиля пользователя" Height="600" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Фамилия:"/>
                <TextBox Text="{Binding CurrentProfile.LastName}"/>

                <TextBlock Text="Имя:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding CurrentProfile.FirstName}"/>

                <TextBlock Text="Отчество:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding CurrentProfile.MiddleName}"/>

                <TextBlock Text="Пол:" Margin="0,10,0,0"/>
                <ComboBox SelectedItem="{Binding CurrentProfile.Gender}" IsEditable="False">
                    <ComboBoxItem Content="Мужской"/>
                    <ComboBoxItem Content="Женский"/>
                </ComboBox>

                <TextBlock Text="Дата рождения:" Margin="0,10,0,0"/>
                <DatePicker SelectedDate="{Binding CurrentProfile.BirthDate}"/>

                <TextBlock Text="Город:" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Cities}" SelectedValue="{Binding CurrentProfile.CityID}" 
                          SelectedValuePath="CityID" DisplayMemberPath="Name"/>

                <TextBlock Text="Знак зодиака:" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding ZodiacSigns}" SelectedValue="{Binding CurrentProfile.ZodiacSignID}" 
                          SelectedValuePath="ZodiacSignID" DisplayMemberPath="RussianName"/>

                <TextBlock Text="Возрастная категория:" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding AgeCategories}" SelectedValue="{Binding CurrentProfile.AgeCategoryID}"
                          SelectedValuePath="AgeCategoryID" DisplayMemberPath="Description"/>

                <TextBlock Text="Интересует пол:" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Genders}"
          SelectedItem="{Binding CurrentProfile.Gender}" 
          IsEditable="False"/>

                <TextBlock Text="О себе:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding CurrentProfile.AboutText}" AcceptsReturn="True" Height="60"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox IsChecked="{Binding CurrentProfile.HasPhoto}" Content="Есть фото" Margin="0,0,10,0"/>
                    <CheckBox IsChecked="{Binding CurrentProfile.IsVerified}" Content="Верифицирован"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>