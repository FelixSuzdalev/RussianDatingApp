<Window x:Class="RussianDatingApp.View.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование аккаунта"
        Height="400" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Email:" Grid.Row="0"/>
        <TextBox Text="{Binding CurrentAccount.Email, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Margin="70,0,0,5"/>

        <TextBlock Text="Телефон:" Grid.Row="1"/>
        <TextBox Text="{Binding CurrentAccount.Phone, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Margin="70,0,0,5"/>

        <TextBlock Text="Пароль (хеш):" Grid.Row="2"/>
        <TextBox Text="{Binding CurrentAccount.PasswordHash, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Margin="120,0,0,5"/>

        <TextBlock Text="Профиль:" Grid.Row="3"/>
        <ComboBox ItemsSource="{Binding UserProfiles}"
                  SelectedItem="{Binding SelectedUserProfile, Mode=TwoWay}"
                  DisplayMemberPath="LastName"
                  Grid.Row="3" Margin="70,0,0,5" />

        <TextBlock Text="Дата регистрации:" Grid.Row="4"/>
        <TextBox Text="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Grid.Row="4" Margin="130,0,0,5" IsReadOnly="True"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>