<Window x:Class="RussianDatingApp.View.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="500" Height="300"
        Topmost="True"
        Opacity="0"
        Loaded="Window_Loaded">

    <Border Background="#FF1E1E1E"
        CornerRadius="16"
        Padding="40"
        BorderBrush="#333"
        BorderThickness="1"
        SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Russian Dating App"
                   Foreground="#FFFFFF"
                   FontSize="26"
                   FontWeight="SemiBold"
                   FontFamily="Montserrat"
                   Margin="0 0 0 20"
                   HorizontalAlignment="Center"/>

            <ProgressBar IsIndeterminate="True"
                     Height="8"
                     Width="280"
                     Foreground="#FF2A9D8F"
                     Background="#333"
                     Margin="0 0 0 20"/>

            <TextBlock Text="Загрузка, пожалуйста подождите..."
                   Foreground="#AAAAAA"
                   FontSize="14"
                   FontFamily="Montserrat"
                   HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>

</Window>
