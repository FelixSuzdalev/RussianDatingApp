<Window x:Class="RussianDatingApp.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RussianDatingApp.ViewModel"
        mc:Ignorable="d"
        Title="Russian Dating - Админ панель"
        Height="800" Width="1200"
        FontFamily="Montserrat"
        Background="#1E1E1E"
        Foreground="#EAEAEA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Кнопки -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Padding" Value="12 6"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="5">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Текстовые поля -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAEAEA"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="RowBackground" Value="#2D2D30"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>

            <Setter Property="Foreground" Value="#FF2A9D8F"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        
        
        <DockPanel>
            <!-- Панель инструментов -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#FFEEEE" >
                <Button Content="Сохранить все" Command="{Binding SaveChangesCommand}" Margin="5" Padding="10 5"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
            </StackPanel>

            <TabControl>
                <!-- Вкладка пользователей -->
                <TabItem Header="👥 Пользователи">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                            <Button Content="Добавить" Command="{Binding AddUserProfileCommand}" Margin="5" Padding="10 5"/>
                            <Button Content="Редактировать" Command="{Binding EditUserProfileCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=usersGrid}"
                    Margin="5" Padding="10 5"/>
                            <Button Content="Удалить" Command="{Binding DeleteUserProfileCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=usersGrid}"
                    Margin="5" Padding="10 5"/>
                            <TextBlock Text="Поиск:" Margin="10 5 5 5" VerticalAlignment="Center" Foreground="#2D2D30"/>
                            <TextBox Width="250" Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="#FF2A9D8F" FontSize="25" Height="29"/>
                            <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center" Foreground="#2D2D30"/>
                            <TextBlock  Text="{Binding UserProfiles.Count}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D30"/>
                        </StackPanel>

                        <DataGrid x:Name="usersGrid"
                  ItemsSource="{Binding FilteredUsers}" AutoGenerateColumns="False"
                  CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Width="250" SortMemberPath="LastName">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="LastName"/>
                                            <Binding Path="FirstName"/>
                                            <Binding Path="MiddleName"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Возраст" Binding="{Binding BirthDate, Converter={StaticResource AgeConverter}}" 
                                  Width="80" SortMemberPath="BirthDate"/>
                                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="70" SortMemberPath="Gender"/>
                                <DataGridTextColumn Header="Ищет" Binding="{Binding InterestedInGender}" Width="70"/>
                                <DataGridTextColumn Header="Город" Binding="{Binding City.Name}" Width="150" SortMemberPath="City.Name"/>
                                <DataGridTextColumn Header="Знак зодиака" Binding="{Binding ZodiacSign.RussianName}" Width="120" SortMemberPath="ZodiacSign.RussianName"/>
                                <DataGridCheckBoxColumn Header="Фото" Binding="{Binding HasPhoto}" Width="60"/>
                                <DataGridCheckBoxColumn Header="Вериф." Binding="{Binding IsVerified}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Вкладка аккаунтов -->
                <TabItem Header="🔐 Аккаунты">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить" Command="{Binding AddUserAccountCommand}" Margin="5" Padding="10 5"/>
                        <Button Content="Редактировать" Command="{Binding EditUserAccountCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=accountsGrid}"
                    Margin="5" Padding="10 5"/>
                        <Button Content="Удалить" Command="{Binding DeleteUserAccountCommand}" 
                    CommandParameter="{Binding SelectedItem, ElementName=accountsGrid}"
                    Margin="5" Padding="10 5"/>
                            <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center" Foreground="#2D2D30"/>
                            <TextBlock Text="{Binding UserAccounts.Count}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D30"/>
                    </StackPanel>

                    <DataGrid x:Name="accountsGrid"
                  ItemsSource="{Binding UserAccounts}" 
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пользователь" Width="250" SortMemberPath="UserProfile.LastName">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="UserProfile.LastName"/>
                                        <Binding Path="UserProfile.FirstName"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" SortMemberPath="Email"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120" SortMemberPath="Phone"/>
                            <DataGridTextColumn Header="Дата регистрации" 
                                      Binding="{Binding Registration.RegistrationDate, StringFormat='dd.MM.yyyy'}" 
                                      Width="120" SortMemberPath="Registration.RegistrationDate"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                </TabItem>
                <!-- Вкладка городов -->
                <TabItem Header="🏙️ Города">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                            <Button Content="Добавить" Command="{Binding AddCityCommand}" Margin="5" Padding="10 5"/>
                            <Button Content="Редактировать"
                                    Command="{Binding EditCityCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=citiesGrid}"
                                    Margin="5" Padding="10 5"/>                         
                            <Button Content="Удалить" Command="{Binding DeleteCityCommand}" 
                                    CommandParameter="{Binding SelectedItem, ElementName=citiesGrid}"
                                    Margin="5" Padding="10 5"/>
                            <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center" Foreground="#2D2D30"/>
                            <TextBlock Text="{Binding Cities.Count}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D30"/>
                        </StackPanel>

                        <DataGrid x:Name="citiesGrid"
                                  ItemsSource="{Binding Cities}" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Город" Binding="{Binding Name}" Width="200" SortMemberPath="Name"/>
                                <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="200" SortMemberPath="Region"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Вкладка знаков зодиака -->
                <TabItem Header="♈ Знаки зодиака">
                    <DockPanel>
                        

                        <DataGrid ItemsSource="{Binding ZodiacSigns}" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ZodiacSignID}" Width="150" SortMemberPath="ZodiacSignID"/>
                                <DataGridTextColumn Header="Знак" Binding="{Binding RussianName}" Width="150" SortMemberPath="RussianName"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Вкладка возрастных категорий -->
                <TabItem Header="🔞 Возрастные категории">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                            <!--Button Content="Добавить" Command="{Binding AddAgeCategoryCommand}" Margin="5" Padding="10 5"!-->
                            <Button Content="Редактировать" Command="{Binding EditAgeCategoryCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=ageCategoryGrid}"
                                    Margin="5" Padding="10 5"/>
                            <Button Content="Удалить" Command="{Binding DeleteAgeCategoryCommand}" 
                                    CommandParameter="{Binding SelectedItem, ElementName=ageCategoryGrid}"
                                    Margin="5" Padding="10 5"/>
                            <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center" Foreground="#2D2D30"/>
                            <TextBlock Text="{Binding AgeCategories.Count}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D30"/>
                        </StackPanel>

                        <DataGrid x:Name="ageCategoryGrid"
                                  ItemsSource="{Binding AgeCategories}" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Диапазон" Width="120">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}-{1} лет">
                                            <Binding Path="AgeFrom"/>
                                            <Binding Path="AgeTo"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" SortMemberPath="Description"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
               
                </TabItem>
                <TabItem Header="💘 Предпочтения">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                            <!--Button Content="Добавить" Command="{Binding AddPartnerPreferenceCommand}" Margin="5" Padding="10 5"/!-->
                            <Button Content="Редактировать" Command="{Binding EditPartnerPreferenceCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=preferenceGrid}"
                    Margin="5" Padding="10 5"/>
                            <Button Content="Удалить" Command="{Binding DeletePartnerPreferenceCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=preferenceGrid}"
                    Margin="5" Padding="10 5"/>
                            <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center" Foreground="#2D2D30"/>
                            <TextBlock Text="{Binding PartnerPreferences.Count}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D30"/>
                        </StackPanel>

                        <DataGrid x:Name="preferenceGrid"
                  ItemsSource="{Binding PartnerPreferences}" AutoGenerateColumns="False"
                  CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Профиль" Width="200">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="UserProfile.LastName"/>
                                            <Binding Path="UserProfile.FirstName"/>
                                            <Binding Path="UserProfile.MiddleName"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Возраст от" Binding="{Binding MinAge}" Width="80"/>
                                <DataGridTextColumn Header="Возраст до" Binding="{Binding MaxAge}" Width="80"/>
                                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="100"/>
                                <DataGridTextColumn Header="Знак зодиака" Binding="{Binding ZodiacSign.RussianName}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Grid>
</Window>