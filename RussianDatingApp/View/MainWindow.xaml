<Window x:Class="RussianDatingApp.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RussianDatingApp.ViewModel"
        xmlns:local="clr-namespace:RussianDatingApp"
        mc:Ignorable="d"
        Title="Russian Dating - Административная панель" 
        Height="800" Width="1200"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <TabControl>
            <!-- Вкладка пользователей -->
            <TabItem Header="👥 Пользователи">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Поиск:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBox Width="250" Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UserProfiles.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilteredUsers}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- Основные колонки -->
                            <DataGridTextColumn Header="ФИО" Width="250" SortMemberPath="LastName">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="LastName"/>
                                        <Binding Path="FirstName"/>
                                        <Binding Path="MiddleName"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Возраст" Binding="{Binding BirthDate, Converter={StaticResource AgeConverter}}" 
                                              Width="80" SortMemberPath="BirthDate"/>
                            <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="70" SortMemberPath="Gender"/>
                            <DataGridTextColumn Header="Ищет" Binding="{Binding InterestedInGender}" Width="70"/>
                            <DataGridTextColumn Header="Город" Binding="{Binding City.Name}" Width="150" SortMemberPath="City.Name"/>
                            <DataGridTextColumn Header="Знак зодиака" Binding="{Binding ZodiacSign.RussianName}" Width="120" SortMemberPath="ZodiacSign.RussianName"/>
                            <DataGridCheckBoxColumn Header="Фото" Binding="{Binding HasPhoto}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Вериф." Binding="{Binding IsVerified}" Width="60"/>
                        </DataGrid.Columns>

                        <!-- Детали строки -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#FFF5F5F5" Padding="10" Margin="5" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="О себе:" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AboutText}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Дата рождения:" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
                                            <TextBlock Text="{Binding BirthDate, StringFormat='dd.MM.yyyy'}" Grid.Row="0" Grid.Column="1"/>

                                            <TextBlock Text="Возрастная категория:" FontWeight="Bold" Grid.Row="0" Grid.Column="2"/>
                                            <TextBlock Text="{Binding AgeCategory.Description}" Grid.Row="0" Grid.Column="3"/>

                                            <TextBlock Text="ID профиля:" FontWeight="Bold" Grid.Row="1" Grid.Column="0"/>
                                            <TextBlock Text="{Binding ProfileID}" Grid.Row="1" Grid.Column="1"/>

                                            <TextBlock Text="Дата регистрации:" FontWeight="Bold" Grid.Row="1" Grid.Column="2"/>
                                            <TextBlock Text="{Binding Registration.RegistrationDate, StringFormat='dd.MM.yyyy HH:mm'}" Grid.Row="1" Grid.Column="3"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Вкладка аккаунтов -->
            <TabItem Header="🔐 Аккаунты">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UserAccounts.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding UserAccounts}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пользователь" Width="250" SortMemberPath="UserProfile.LastName">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="UserProfile.LastName"/>
                                        <Binding Path="UserProfile.FirstName"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" SortMemberPath="Email"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120" SortMemberPath="Phone"/>
                            <DataGridTextColumn Header="Дата регистрации" 
                                              Binding="{Binding Registration.RegistrationDate, StringFormat='dd.MM.yyyy'}" 
                                              Width="120" SortMemberPath="Registration.RegistrationDate"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Вкладка предпочтений -->
            <TabItem Header="💖 Предпочтения">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PartnerPreferences.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding PartnerPreferences}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пользователь" Width="250" SortMemberPath="UserProfile.LastName">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="UserProfile.LastName"/>
                                        <Binding Path="UserProfile.FirstName"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Возраст" Width="120">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}-{1} лет">
                                        <Binding Path="MinAge"/>
                                        <Binding Path="MaxAge"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Знак зодиака" Binding="{Binding ZodiacSign.RussianName}" Width="120" SortMemberPath="ZodiacSign.RussianName"/>
                            <DataGridTextColumn Header="Рост" Width="120">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}-{1} см">
                                        <Binding Path="MinHeight"/>
                                        <Binding Path="MaxHeight"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Вкладка городов -->
            <TabItem Header="🏙️ Города">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Cities.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Cities}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Город" Binding="{Binding Name}" Width="200" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="200" SortMemberPath="Region"/>
                            <DataGridTextColumn Header="Пользователей" Width="100">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UserProfiles.Count" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Вкладка знаков зодиака -->
            <TabItem Header="♈ Знаки зодиака">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ZodiacSigns.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding ZodiacSigns}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Знак" Binding="{Binding RussianName}" Width="150" SortMemberPath="RussianName"/>
                            <DataGridTextColumn Header="Англ. название" Binding="{Binding Name}" Width="150" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Пользователей" Width="100">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UserProfiles.Count" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Вкладка возрастных категорий -->
            <TabItem Header="🔞 Возрастные категории">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AgeCategories.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding AgeCategories}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Диапазон" Width="120">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}-{1} лет">
                                        <Binding Path="AgeFrom"/>
                                        <Binding Path="AgeTo"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" SortMemberPath="Description"/>
                            <DataGridTextColumn Header="Пользователей" Width="100">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UserProfiles.Count" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Вкладка регистраций -->
            <TabItem Header="📅 Регистрации">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="5" Padding="10 5"/>
                        <TextBlock Text="Всего:" Margin="10 5 5 5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Registrations.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Registrations}" AutoGenerateColumns="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding RegistrationDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="150" SortMemberPath="RegistrationDate"/>
                            <DataGridTextColumn Header="Аккаунтов" Width="100">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UserAccounts.Count" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Пользователей" Width="100">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UserProfiles.Count" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>