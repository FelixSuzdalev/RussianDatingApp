<Window x:Class="RussianDatingApp.View.EditAgeCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование возрастной категории" Height="300" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Возраст от:"/>
            <TextBox Text="{Binding CurrentAgeCategory.AgeFrom, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Возраст до:" Margin="0,10,0,0"/>
            <TextBox Text="{Binding CurrentAgeCategory.AgeTo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Описание:" Margin="0,10,0,0"/>
            <TextBox Text="{Binding CurrentAgeCategory.Description, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Height="25" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" Height="25"/>
        </StackPanel>
    </Grid>
</Window>